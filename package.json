  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "prettier": "^3.9.8",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
